%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51f1835016ff0a34f94d5a8c060c9cdd, type: 3}
  m_Name: Instructions
  m_EditorClassIdentifier: 
  instructions:
  - name: Mainspring
    instructionText: This is the heart of the clock's power. It's a long, coiled
      strip of metal stored within a cylindrical barrel. When wound, it stores potential
      energy
    sprite: {fileID: 21300000, guid: 7461125ec591a1548883bd61123e9138, type: 3}
    audioClip: {fileID: 8300000, guid: b319a2e4ff8f5d840b82d8635b645d22, type: 3}
  - name: Mainspring Barrel
    instructionText: The cylindrical container that houses the mainspring. The outer
      end of the mainspring is attached to the barrel wall, and the inner end is
      attached to an arbor (a central shaft)
    sprite: {fileID: 7681201850867341242, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 8300000, guid: 16fba6d30ed741d4a9fdd6e79ee2f3ac, type: 3}
  - name: Power Transmission and Speed Reduction (The Going Train)
    instructionText: A series of interconnected gears (wheels) and pinions (small
      gears) that transmit the energy from the mainspring barrel. Each large gear
      drives a smaller pinion on the same arbor as the next larger wheel
    sprite: {fileID: 2289998852469363648, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 8300000, guid: d14b106713a74b448bcab90869f1706e, type: 3}
  - name: Gear Train (or Wheel Train)
    instructionText: A series of interconnected gears (wheels) and pinions (small
      gears) that transmit the energy from the mainspring barrel. Each large gear
      drives a smaller pinion on the same arbor as the next larger wheel.
    sprite: {fileID: 3495086814825567685, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 8300000, guid: eeeda5dce5e1d344f8e2f6195f16cb38, type: 3}
  - name: Pallet Fork (or Lever)
    instructionText: A lever with two "pallets" (small, usually jewel-tipped surfaces)
      that engage with the teeth of the escape wheel. It swings back and forth, alternately
      locking and unlocking the escape wheel
    sprite: {fileID: -1659708932042841261, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 8300000, guid: 9a6d738025ed59f4fb946bb59c20e774, type: 3}
  - name: Balance Wheel
    instructionText: ' A weighted wheel that oscillates back and forth at a very
      precise frequency. It''s the "heartbeat" of the clock'
    sprite: {fileID: 3495086814825567685, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 0}
  - name: Hairspring (or Balance Spring)
    instructionText: To control the rate of oscillation of the balance wheel. Its
      elasticity ensures that the balance wheel swings back and forth with a consistent
      period. The combination of the balance wheel and hairspring forms a resonant
      system that dictates the clock's accuracy
    sprite: {fileID: -1659708932042841261, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 0}
  - name: Motion Work (or Dial Train)
    instructionText: A separate set of gears on the dial side of the movement, distinct
      from the main gear train. It connects the minute hand (driven by the center
      wheel) to the hour hand.
    sprite: {fileID: 2061223666325461347, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 0}
  - name: Hands
    instructionText: The hour, minute, and (optional) second hands that are mounted
      on the arbors of the motion work and gear train
    sprite: {fileID: 2061223666325461347, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 0}
  - name: Dial
    instructionText: The face of the clock, typically with hour markers and numerals
    sprite: {fileID: 21300016, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 0}
  - name: Crown and Stem (for winding/setting)
    instructionText: A knob on the outside of the case connected to a stem that extends
      into the movement
    sprite: {fileID: 2061223666325461347, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 0}
  - name: Case
    instructionText: The outer housing that protects all the intricate internal components
    sprite: {fileID: -1659708932042841261, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 0}
  - name: Crystal
    instructionText: ' The transparent cover over the dial, usually made of glass
      or sapphire'
    sprite: {fileID: 7245690677989368111, guid: 215687feeab0b7445b4a1cd86c82c2e1, type: 3}
    audioClip: {fileID: 0}
