%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51f1835016ff0a34f94d5a8c060c9cdd, type: 3}
  m_Name: Instructions
  m_EditorClassIdentifier: 
  instructions:
  - name: wait
    sprite: {fileID: 0}
    audioClip: {fileID: 0}
    instructionText: 
    nextStageConditions:
      timeToNextStage: 10
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
  - name: Hello
    sprite: {fileID: 8398557208487646791, guid: 068559f04df911c4b98f00f15e86aa7e, type: 2}
    audioClip: {fileID: 8300000, guid: decdd4729562a4245a6925c21f7a2027, type: 3}
    instructionText: "Hello, dear guest\u2014and welcome.\nToday, you\u2019ll step
      into the world of precision, patience... and a bit of magic.\nYou\u2019re about
      to build your very own mechanical watch."
    nextStageConditions:
      timeToNextStage: 15
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
  - name: Final Creation
    sprite: {fileID: 409948387602054397, guid: 2dbd778585cad2044ad141aa1f7e172b, type: 2}
    audioClip: {fileID: 8300000, guid: 70bce285258553c489ae3f43b7115c42, type: 3}
    instructionText: "In front of you is the final creation\u2014fully assembled.\nGo
      ahead\u2014grab it with both hands... and scale it."
    nextStageConditions:
      timeToNextStage: 0
      onGrabObjectName: uhrMuseum
      onDropObjectName: 
      onSnapObjectName: 
  - name: Scalling
    sprite: {fileID: 409948387602054397, guid: 2dbd778585cad2044ad141aa1f7e172b, type: 2}
    audioClip: {fileID: 8300000, guid: d28347158e280284dacc632d07f31f12, type: 3}
    instructionText: 'If you grab an object with both hands, you can scale it. Move
      your hands closer or farther apart to change its size.

      As it grows,
      watch how the pieces float apart.

      This is the hidden world inside every
      mechanical watch.

      A dance of gears, springs, and tiny marvels.'
    nextStageConditions:
      timeToNextStage: 25
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
  - name: Throw it away
    sprite: {fileID: 409948387602054397, guid: 2dbd778585cad2044ad141aa1f7e172b, type: 2}
    audioClip: {fileID: 8300000, guid: 607f3e25c40e5754e9f293a70ddd01c4, type: 3}
    instructionText: When you're ready, give it a gentle toss to begin your own journey.
    nextStageConditions:
      timeToNextStage: 6
      onGrabObjectName: 
      onDropObjectName: uhrMuseum
      onSnapObjectName: 
  - name: Intro
    sprite: {fileID: 409948387602054397, guid: 2dbd778585cad2044ad141aa1f7e172b, type: 2}
    audioClip: {fileID: 8300000, guid: 032eb96cc2e614544b7648fd7a340188, type: 3}
    instructionText: "This is the main plate\u2014the base of the watch.\nOn your
      right, you'll see several loose gears. Take a moment to look around."
    nextStageConditions:
      timeToNextStage: 15
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
  - name: The Main Plate
    sprite: {fileID: 5597866820062511089, guid: b67720d903bde5348a251d146c89d5d5, type: 2}
    audioClip: {fileID: 8300000, guid: 8972a0774dff3704f9507bfb4ec63b85, type: 3}
    instructionText: 'The main plate is the large yellow piece. Everything else connects
      to it.

      Feel free to move it around and get comfortable.'
    nextStageConditions:
      timeToNextStage: 15
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
  - name: The Barrel
    sprite: {fileID: -8370015614666040204, guid: 370ba82b73d44544aaf452de14c4ef4d, type: 2}
    audioClip: {fileID: 8300000, guid: e3a181d520ca1e7449ec0a9bc2dbc3a4, type: 3}
    instructionText: "Now, look for the red gear\u2014that\u2019s the barrel.\nTake
      a moment to find it and pick it up"
    nextStageConditions:
      timeToNextStage: 0
      onGrabObjectName: GearRed
      onDropObjectName: 
      onSnapObjectName: 
  - name: The Barrel
    sprite: {fileID: 10916, guid: 0000000000000000f000000000000000, type: 0}
    audioClip: {fileID: 8300000, guid: c74e36283cf5fdf46beb9f4795abc773, type: 3}
    instructionText: "Well done. The piece you\u2019re holding is the barrel\u2014the
      heart of the watch.\nIt\u2019s the only part that powers itself."
    nextStageConditions:
      timeToNextStage: 9
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
  - name: The Barrel
    sprite: {fileID: 2800000, guid: 9430f133ccdfa5e408338d568da2827d, type: 3}
    audioClip: {fileID: 8300000, guid: 6550edfc711649a4cbfabf77303e98ec, type: 3}
    instructionText: "Inside, there's a coiled spring storing energy.\nAs it unwinds,
      it pushes the gear\u2014keeping time alive."
    nextStageConditions:
      timeToNextStage: 9
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
  - name: The Barrel
    sprite: {fileID: 2800000, guid: 9430f133ccdfa5e408338d568da2827d, type: 3}
    audioClip: {fileID: 8300000, guid: 89f3faea7d8ef7246b67f49c418e751a, type: 3}
    instructionText: 'On its own, a barrel can power about 14,000 rotations.

      That
      only lasts around four hours. Not quite enough, is it?'
    nextStageConditions:
      timeToNextStage: 9
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
  - name: Gears
    sprite: {fileID: 2800000, guid: 9430f133ccdfa5e408338d568da2827d, type: 3}
    audioClip: {fileID: 8300000, guid: 561521d20fe115a44b46f08236900604, type: 3}
    instructionText: "Let\u2019s fix that. Place the barrel somewhere easy to reach...
      and pick up the brown gear."
    nextStageConditions:
      timeToNextStage: 0
      onGrabObjectName: GearBrown
      onDropObjectName: 
      onSnapObjectName: 
  - name: Multiply Rotations.
    sprite: {fileID: 2800000, guid: 9430f133ccdfa5e408338d568da2827d, type: 3}
    audioClip: {fileID: 8300000, guid: b1f9515a03a05494b9a61b73fa8b74fa, type: 3}
    instructionText: "Try connecting the brown gear to the barrel.\nNotice how it
      spins faster?\nSmaller gears multiply speed\u2014and that\u2019s how we stretch
      battery life."
    nextStageConditions:
      timeToNextStage: 20
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
  - name: Assembly The Watch
    sprite: {fileID: 2800000, guid: 9430f133ccdfa5e408338d568da2827d, type: 3}
    audioClip: {fileID: 8300000, guid: 17956d5841da88d42b1014047df44a7c, type: 3}
    instructionText: "Now that you\u2019ve seen how they work, let\u2019s try placing
      all the pieces in their correct spots on the main plate."
    nextStageConditions:
      timeToNextStage: 0
      onGrabObjectName: 
      onDropObjectName: 
      onSnapObjectName: 
